; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="BeatAndMatchToPass"
run/main_scene="res://src/UI/boot.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.933333, 0.372549, 0, 1)
boot_splash/image="res://src/UI/boot/logodupot.png"
config/icon="res://icon.png"

[autoload]

Events="*res://src/Common/Autoload/Events.gd"
Game="*res://src/Common/Autoload/Game.gd"
GlobalPlayer="*res://src/Common/Autoload/GlobalPlayer.gd"
GlobalVersion="*res://src/Common/Autoload/GlobalVersion.gd"
Sound="*res://src/Common/Autoload/Sound.gd"
Transition="*res://src/Common/Autoload/Transition.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1230
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"

